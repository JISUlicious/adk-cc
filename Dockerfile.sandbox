# adk-cc per-session sandbox image.
#
# Built once on the sandbox host:
#   docker build -t adk-cc-sandbox:latest -f Dockerfile.sandbox .
#
# Behind a proxy / restricted network. NO_PROXY is usually required, not
# optional: anything reachable DIRECTLY (an internal Debian mirror, an internal
# PyPI) must bypass the proxy or its fetches fail.
#   docker build -t adk-cc-sandbox:latest -f Dockerfile.sandbox \
#     --build-arg HTTP_PROXY=http://proxy.corp:3128 \
#     --build-arg HTTPS_PROXY=http://proxy.corp:3128 \
#     --build-arg NO_PROXY=localhost,127.0.0.1,.corp,mirror.corp.com \
#     --build-arg APT_PROXY=http://proxy.corp:3128 \
#     --build-arg PIP_INDEX_URL=https://nexus.corp/repository/pypi/simple \
#     --build-arg PIP_TRUSTED_HOST=nexus.corp .
#
# Operators can swap a custom image via ADK_CC_SANDBOX_IMAGE.

FROM python:3.13.11-slim

# --- optional egress config -------------------------------------------------
# Standard proxy vars, set BEFORE anything fetches. Both cases on purpose:
# some clients read only lowercase, some only uppercase.
#
# NO_PROXY is not decoration — on a restricted network it is usually what makes
# the build work at all. Verified against this base image: with a proxy in
# apt.conf and an unreachable proxy host, `apt-get update` fails every repo;
# adding no_proxy for those repo hosts makes apt bypass the proxy and install
# succeed. So env no_proxy OVERRIDES the apt.conf proxy per host, which is
# exactly what an internal Debian mirror needs.
#
# Two things to know before setting these:
#   - no_proxy does NOT support CIDR in apt, curl, or Python — it is suffix
#     matching. "10.0.0.0/8" silently matches nothing; use ".corp" or hosts.
#   - these persist into the image (see the ENV note below). If your proxy URL
#     embeds credentials, do NOT bake it in — leave these empty and inject at
#     runtime with ADK_CC_SANDBOX_ENV instead.
#
# HTTP_PROXY / HTTPS_PROXY / NO_PROXY are predefined build args in Docker, so
# they are also picked up from the client environment automatically and kept
# out of `docker history`.
ARG HTTP_PROXY=""
ARG HTTPS_PROXY=""
ARG NO_PROXY=""
ENV http_proxy=${HTTP_PROXY} https_proxy=${HTTPS_PROXY} no_proxy=${NO_PROXY} \
    HTTP_PROXY=${HTTP_PROXY} HTTPS_PROXY=${HTTPS_PROXY} NO_PROXY=${NO_PROXY}

# apt-specific proxy, for when apt must use a different one than everything
# else (or when only apt is proxied). Written BEFORE the first apt-get: a proxy
# configured after it is useless, because the update that needed it has already
# failed. Default empty, so an unrestricted build never creates the file.
ARG APT_PROXY=""
RUN if [ -n "$APT_PROXY" ]; then \
        printf 'Acquire::http::Proxy "%s";\nAcquire::https::Proxy "%s";\n' \
            "$APT_PROXY" "$APT_PROXY" > /etc/apt/apt.conf.d/proxy.conf; \
        echo "apt proxy configured: $APT_PROXY (no_proxy=${NO_PROXY:-unset})"; \
    fi

# A network that blocks apt almost always blocks PyPI too, and pip runs on the
# very next layer — an apt-only proxy would stall this build one step later.
# Unset = plain PyPI (pip treats the empty value as absent; verified).
#
# These are ENV rather than plain ARG on purpose: they persist into the running
# container, so the lazy `pip install` a third-party skill performs at RUNTIME
# reaches the same private index. A sandbox on a restricted network has no
# route to PyPI either.
ARG PIP_INDEX_URL=""
ARG PIP_TRUSTED_HOST=""
ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST}

# --- system packages --------------------------------------------------------
# Common shell + search tools the agent reaches for. ripgrep / fd are
# fast alternatives the model often prefers; build-essential lets pip
# compile any C extensions if a notebook installs something extra.
#
# libgomp1 only LOOKS optional: xgboost links OpenMP at import time, and on a
# -slim base the import dies with a bare "libgomp.so.1: cannot open shared
# object file" that reads like a broken package rather than a missing lib.
#
# Korean faces + fontconfig so Hangul renders in matplotlib/plotly output
# instead of tofu boxes — the whole point of charting Korean data.
# NOTE on the font list: Debian 13 (trixie) DROPPED fonts-nanum-coding, and a
# missing font package fails the whole layer with a bare apt exit 100. Naver's
# monospace face now ships as fonts-naver-d2coding, which is what replaces it
# here. Re-check these names when the base image moves to a new Debian.
RUN apt-get update && apt-get install -y --no-install-recommends \
        bash coreutils findutils grep sed gawk \
        git curl ripgrep fd-find \
        build-essential \
        libgomp1 \
        fontconfig \
        fonts-nanum fonts-nanum-extra fonts-nanum-eco fonts-naver-d2coding \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/*

# --- uv ---------------------------------------------------------------------
# NOT optional, despite nothing in this image importing it: `analysis_env`
# provisions the code-execution interpreter AT RUNTIME, inside this container,
# and `_provision()` opens with `command -v uv` and raises
# "uv is not available in the execution environment" when it is missing. Without
# this line every skill script fails on the docker backend. Dockerfile.daytona-
# snapshot has always installed it; this image was simply missing the same step.
#
# Installed from PyPI rather than the upstream `curl https://astral.sh/... | sh`
# that the Daytona image uses, because pip goes through PIP_INDEX_URL and the
# proxy configured above — on a restricted network an internal mirror is
# reachable when astral.sh very likely is not.
RUN pip install --no-cache-dir uv && uv --version

# --- python: analysis -------------------------------------------------------
# Covers the typical 50K rows × ~1K columns pandas / numpy / sklearn
# workloads, plus polars + duckdb for the faster columnar paths.
RUN pip install --no-cache-dir \
        pandas numpy scipy scikit-learn \
        matplotlib seaborn \
        polars pyarrow duckdb \
        requests httpx

# --- python: modelling + charting -------------------------------------------
# xgboost-cpu, not xgboost: the default wheel drags in nvidia-nccl and friends
# for GPU support — 244 MB of CUDA in a sandbox that has no GPU. Same
# `import xgboost`, same API; manylinux wheels exist for x86_64 and aarch64.
# Switch back to plain `xgboost` if these containers ever get a GPU.
#
# kaleido is pinned to the 0.x line deliberately. It is what makes
# `fig.write_image()` work, which the bundled data-analyst skill documents and
# which is the only way a headless agent can DELIVER a chart as a file. 0.2.1
# bundles its own renderer (~85 MB, both arches); kaleido >= 1.0 instead
# shells out to a real Chrome, and the lightest Debian option for that is
# chromium-headless-shell at 800 MB — an unacceptable trade on an image this
# size. The 0.x line is deprecated upstream, so when a future plotly finally
# drops it, `tests/e2e_sandbox_image_libs.py` fails on the PNG check rather
# than silently shipping an image that cannot export; at that point the choice
# is to accept the browser or drop static export.
RUN pip install --no-cache-dir \
        xgboost-cpu \
        plotly "kaleido==0.2.1"

# --- python: office documents -----------------------------------------------
# xlsx read/write (openpyxl both ways, xlsxwriter for rich formatting and
# native charts), legacy .xls reads, odf, docx, pptx.
RUN pip install --no-cache-dir \
        openpyxl xlsxwriter xlrd odfpy \
        python-docx python-pptx

# HWP is the Korean office format and needs two paths, not one:
#   pyhwp  — binary .hwp v5, an OLE container, read via olefile
#   lxml   — .hwpx, which is just a zip of XML and needs no special reader
# olefile + lxml are installed unconditionally so .hwpx and raw OLE parsing
# work regardless. pyhwp is a much older package and is the one plausible
# casualty of the 3.13 bump, so it gets its own layer and is allowed to fail
# the build loudly-but-not-fatally rather than costing us every library above.
RUN pip install --no-cache-dir olefile lxml
RUN pip install --no-cache-dir pyhwp \
    || echo "WARN: pyhwp did not install on this Python — binary .hwp reads \
are unavailable; .hwpx still works via lxml"

# Make the Korean faces a fallback rather than leaving every script to
# configure fonts itself. DejaVu stays first for Latin text; NanumGothic
# supplies the glyphs it lacks. unicode_minus off because the Unicode minus
# sign is itself missing from the Nanum faces and renders as a box on axes.
# The two replacements below are string-matched against upstream's shipped
# matplotlibrc, so they fail closed: a future matplotlib that renames either
# key would otherwise leave a silently unconfigured image that only shows up
# as tofu boxes in a user's chart months later.
RUN python - <<'PY'
import pathlib, matplotlib
p = pathlib.Path(matplotlib.matplotlib_fname())
t = orig = p.read_text()
t = t.replace("#font.sans-serif:",
              "font.sans-serif: DejaVu Sans, NanumGothic, NanumBarunGothic, ")
t = t.replace("#axes.unicode_minus: True", "axes.unicode_minus: False")
if t == orig:
    raise SystemExit(f"matplotlibrc keys not found in {p} — patch is stale")
p.write_text(t)
from matplotlib import font_manager
names = {f.name for f in font_manager.fontManager.ttflist}
if not any(n.startswith("Nanum") for n in names):
    raise SystemExit("no Nanum face visible to matplotlib — font install failed")
print("matplotlib Korean fallback configured:", p)
PY

# Unprivileged runtime user (matches the user= setting in the spawn
# config so workspace writes get the right ownership).
RUN useradd -u 1000 -m -s /bin/bash sandbox

WORKDIR /workspace
USER 1000:1000

# The container is started with `command=["sleep", "infinity"]` from
# DockerBackend; this CMD is just the default if started by hand.
CMD ["sleep", "infinity"]
